# ============================================
# VARIABLES DE ENTORNO — Ninjabot (Vite)
# Copia este archivo a .env.local para desarrollo
# o .env.production para el build de despliegue.
#
# ⚠️ NUNCA comitees .env.local ni .env.production
#    (ver .gitignore). El pipeline de CI/CD debe
#    inyectar estas variables al build.
# ============================================

# Supabase Credentials (obligatorias — el build FALLA sin ellas)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY_PUBLICA

# Meta / WhatsApp Credentials
VITE_META_APP_ID=TU_META_APP_ID
VITE_META_EMBEDDED_SIGNUP_CONFIG_ID=TU_CONFIG_ID